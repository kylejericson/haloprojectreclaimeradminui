# Absolute path to the Reclaimer folder containing dedicated.toml.
SERVER_DIR_HOST=/srv/reclaimer

# Use the numeric owner of SERVER_DIR_HOST so the panel can safely edit files.
PUID=65534
PGID=65534

# Required UI login password. Replace before starting.
ADMIN_PASSWORD=

# Set 0.0.0.0 for LAN/VPN access; restrict it with your firewall.
BIND_HOST=0.0.0.0
PORT=8780
COOKIE_SECURE=false
